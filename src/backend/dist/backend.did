type VerifyOtpResult = 
 record {
   isNewUser: bool;
   sessionToken: text;
   user: User;
 };
type UserRole = 
 variant {
   BUYER;
   SELLER;
 };
type User = 
 record {
   businessType: opt BusinessType;
   createdAt: Timestamp;
   deliveryLocation: opt text;
   id: nat;
   kycRejectionReason: opt KycRejectionReason;
   kycStatus: KycStatus;
   name: text;
   phone: text;
   primaryCategoryId: opt nat;
   roles: vec UserRole;
 };
type Timestamp = int;
type TicketStatus = 
 variant {
   CLOSED;
   IN_PROGRESS;
   OPEN;
   RESOLVED;
 };
type TicketInput = 
 record {
   body: text;
   category: TicketCategory;
   subject: text;
 };
type TicketCategory = 
 variant {
   ACCOUNT;
   KYC;
   ORDER_DISPUTE;
   PAYMENTS;
   TECHNICAL;
 };
type SupportTicket = 
 record {
   assignedAdminId: opt nat;
   body: text;
   category: TicketCategory;
   createdAt: Timestamp;
   id: nat;
   priority: Priority;
   status: TicketStatus;
   subject: text;
   userId: nat;
 };
type SendOtpResult = 
 record {
   expiresInSecs: nat;
   requestId: text;
 };
type SellerListingAction = 
 variant {
   Archive;
   Pause;
   Restock: nat;
   Resume;
 };
type Result_9 = 
 variant {
   err: ApiError;
   ok: vec SupportTicket;
 };
type Result_8 = 
 variant {
   err: ApiError;
   ok: vec OrderView;
 };
type Result_7 = 
 variant {
   err: ApiError;
   ok: CheckoutIntent;
 };
type Result_6 = 
 variant {
   err: ApiError;
   ok: record {
         bankName: text;
         branch: text;
       };
 };
type Result_5 = 
 variant {
   err: ApiError;
   ok;
 };
type Result_4 = 
 variant {
   err: ApiError;
   ok: SendOtpResult;
 };
type Result_3 = 
 variant {
   err: ApiError;
   ok: KycState;
 };
type Result_25 = 
 variant {
   err: ApiError;
   ok: BankAccount;
 };
type Result_24 = 
 variant {
   err: ApiError;
   ok: vec KycQueueRow;
 };
type Result_23 = 
 variant {
   err: ApiError;
   ok: vec ModerationRow;
 };
type Result_22 = 
 variant {
   err: ApiError;
   ok: Reports;
 };
type Result_21 = 
 variant {
   err: ApiError;
   ok: AdminLoginResult;
 };
type Result_20 = 
 variant {
   err: ApiError;
   ok: KycDocument;
 };
type Result_2 = 
 variant {
   err: ApiError;
   ok: OrderView;
 };
type Result_19 = 
 variant {
   err: ApiError;
   ok: AppConfig;
 };
type Result_18 = 
 variant {
   err: ApiError;
   ok: User;
 };
type Result_17 = 
 variant {
   err: ApiError;
   ok: ConfirmCheckoutResult;
 };
type Result_16 = 
 variant {
   err: ApiError;
   ok: SupportTicket;
 };
type Result_15 = 
 variant {
   err: ApiError;
   ok: PublicListing;
 };
type Result_14 = 
 variant {
   err: ApiError;
   ok: MeView;
 };
type Result_13 = 
 variant {
   err: ApiError;
   ok: vec BankAccount;
 };
type Result_12 = 
 variant {
   err: ApiError;
   ok: vec Listing;
 };
type Result_11 = 
 variant {
   err: ApiError;
   ok: vec Notification;
 };
type Result_10 = 
 variant {
   err: ApiError;
   ok: vec Payout;
 };
type Result_1 = 
 variant {
   err: ApiError;
   ok: Listing;
 };
type Result = 
 variant {
   err: ApiError;
   ok: VerifyOtpResult;
 };
type Reports = 
 record {
   activeUserCount: nat;
   fromNs: Timestamp;
   gmvInr: nat;
   newListingCount: nat;
   newUserCount: nat;
   orderCount: nat;
   payoutPaidInr: nat;
   publishedListingCount: nat;
   refundedOrderCount: nat;
   toNs: Timestamp;
   totalUserCount: nat;
 };
type ReportRange = 
 record {
   fromNs: Timestamp;
   toNs: Timestamp;
 };
type PublicListing = 
 record {
   attributes: vec record {
                     text;
                     text;
                   };
   categoryId: nat;
   categoryName: text;
   createdAt: Timestamp;
   description: text;
   id: nat;
   images: vec ListingImage;
   location: text;
   priceInr: nat;
   quantity: nat;
   sellerId: nat;
   sellerKycVerified: bool;
   sellerName: text;
   status: ListingStatus;
   title: text;
   unit: text;
 };
type PublicConfig = 
 record {
   commissionBps: nat;
   environment: Environment;
   kycAttemptWindowHours: nat;
   kycCheckoutThresholdInr: nat;
   kycMaxAttempts: nat;
   otpExpirySecs: nat;
   otpRateLimitMax: nat;
   otpRateLimitWindowSecs: nat;
   payoutHoldHours: nat;
 };
type Priority = 
 variant {
   HIGH;
   LOW;
   MEDIUM;
 };
type PayoutStatus = 
 variant {
   FAILED;
   PAID;
   PROCESSING;
   SCHEDULED;
 };
type Payout = 
 record {
   amountInr: nat;
   bankAccountId: nat;
   createdAt: Timestamp;
   id: nat;
   orderId: opt nat;
   paidAt: opt Timestamp;
   scheduledFor: Timestamp;
   status: PayoutStatus;
   userId: nat;
 };
type PaymentStatus = 
 variant {
   FAILED;
   PAID;
   PENDING;
   REFUNDED;
 };
type PaymentMethod = 
 variant {
   CARD;
   NETBANKING;
   UPI;
 };
type Payment = 
 record {
   amountInr: nat;
   buyerId: nat;
   createdAt: Timestamp;
   idempotencyKey: text;
   listingId: nat;
   method: PaymentMethod;
   orderId: opt nat;
   provider: text;
   providerPaymentId: text;
   quantity: nat;
   status: PaymentStatus;
   updatedAt: Timestamp;
 };
type OrderView = 
 record {
   buyerName: text;
   listingImageUrl: opt text;
   listingTitle: text;
   listingUnit: text;
   order: Order;
   sellerName: text;
 };
type OrderStatus = 
 variant {
   CANCELLED;
   COMPLETED;
   CONFIRMED;
   DISPUTED;
   IN_PROGRESS;
   PLACED;
   RESOLVED;
 };
type OrderEvent = 
 record {
   at: Timestamp;
   note: text;
   status: OrderStatus;
 };
type Order = 
 record {
   buyerId: nat;
   createdAt: Timestamp;
   id: nat;
   listingId: nat;
   paymentStatus: PaymentStatus;
   quantity: nat;
   sellerId: nat;
   status: OrderStatus;
   timeline: vec OrderEvent;
   totalAmountInr: nat;
   updatedAt: Timestamp;
 };
type OnboardingProfile = 
 variant {
   Buyer: record {
            deliveryLocation: text;
            name: text;
          };
   Seller:
    record {
      businessType: BusinessType;
      name: text;
      primaryCategoryId: nat;
    };
 };
type NotificationType = 
 variant {
   KYC_UPDATE;
   LISTING_UPDATE;
   ORDER_UPDATE;
   PAYOUT_UPDATE;
   SYSTEM;
 };
type NotificationPayload = 
 record {
   kycDocumentId: opt nat;
   listingId: opt nat;
   orderId: opt nat;
   payoutId: opt nat;
 };
type Notification = 
 record {
   body: text;
   createdAt: Timestamp;
   id: nat;
   notificationType: NotificationType;
   payload: NotificationPayload;
   read: bool;
   title: text;
   userId: nat;
 };
type ModerationRow = 
 record {
   categoryName: text;
   listing: Listing;
   sellerKycStatus: KycStatus;
   sellerName: text;
 };
type ModerationAction = 
 variant {
   Approve;
   Reject: text;
   RequestChanges: text;
 };
type MeView = 
 record {
   hasVerifiedBankAccount: bool;
   unreadNotifications: nat;
   user: User;
 };
type ListingStatus = 
 variant {
   ARCHIVED;
   DRAFT;
   PAUSED;
   PENDING_REVIEW;
   PUBLISHED;
   REJECTED;
   SOLD_OUT;
 };
type ListingInput = 
 record {
   attributes: vec record {
                     text;
                     text;
                   };
   categoryId: nat;
   description: text;
   images: vec ListingImage;
   location: text;
   priceInr: nat;
   quantity: nat;
   title: text;
   unit: text;
 };
type ListingImage = 
 record {
   order: nat;
   qualityFlag: opt ImageQualityFlag;
   url: text;
 };
type Listing = 
 record {
   attributes: vec record {
                     text;
                     text;
                   };
   categoryId: nat;
   createdAt: Timestamp;
   description: text;
   id: nat;
   images: vec ListingImage;
   location: text;
   moderationNote: opt text;
   priceInr: nat;
   quantity: nat;
   sellerId: nat;
   status: ListingStatus;
   title: text;
   unit: text;
   updatedAt: Timestamp;
 };
type KycSubmission = 
 record {
   docType: KycDocType;
   fileUrl: text;
   selfieUrl: opt text;
 };
type KycStatus = 
 variant {
   IN_REVIEW;
   NONE;
   PENDING;
   REJECTED;
   VERIFIED;
 };
type KycState = 
 record {
   attemptsUsedInWindow: nat;
   canResubmit: bool;
   documents: vec KycDocument;
   maxAttempts: nat;
   rejectionReason: opt KycRejectionReason;
   status: KycStatus;
 };
type KycReviewDecision = 
 variant {
   Approve;
   Reject: KycRejectionReason;
 };
type KycRejectionReason = 
 variant {
   BLURRY_DOCUMENT;
   EXPIRED_DOCUMENT;
   FRAUD_SUSPECTED;
   NAME_MISMATCH;
   SELFIE_MISMATCH;
 };
type KycQueueRow = 
 record {
   applicantName: text;
   applicantPhone: text;
   applicantRoles: vec UserRole;
   document: KycDocument;
   priority: Priority;
 };
type KycGateInfo = 
 record {
   canResubmit: bool;
   kycStatus: KycStatus;
   message: text;
   rejectionReason: opt KycRejectionReason;
 };
type KycDocument = 
 record {
   attemptNumber: nat;
   confidenceScore: opt float64;
   docType: KycDocType;
   fileUrl: text;
   id: nat;
   isLatest: bool;
   rejectionReason: opt KycRejectionReason;
   reviewedAt: opt Timestamp;
   reviewedBy: opt nat;
   selfieUrl: opt text;
   status: KycDocStatus;
   submittedAt: Timestamp;
   userId: nat;
 };
type KycDocType = 
 variant {
   AADHAAR;
   GST;
   PAN;
 };
type KycDocStatus = 
 variant {
   IN_REVIEW;
   PENDING;
   REJECTED;
   VERIFIED;
 };
type ImageQualityFlag = 
 variant {
   BLURRY;
   LOW_RESOLUTION;
 };
type Environment = 
 variant {
   Development;
   Production;
 };
type DisputeOutcome = 
 variant {
   RefundBuyer;
   ReleaseToSeller;
 };
type ConfirmCheckoutResult = 
 record {
   order: opt OrderView;
   payment: Payment;
 };
type CheckoutIntent = 
 record {
   listingTitle: text;
   payment: Payment;
 };
type CheckoutInput = 
 record {
   idempotencyKey: text;
   listingId: nat;
   method: PaymentMethod;
   quantity: nat;
 };
type Category = 
 record {
   attributeSchema: vec AttributeField;
   id: nat;
   name: text;
   parentId: opt nat;
 };
type BusinessType = 
 variant {
   INDIVIDUAL;
   REGISTERED;
 };
type BrowseFilter = 
 record {
   categoryId: opt nat;
   search: opt text;
 };
type BankVerificationStatus = 
 variant {
   FAILED;
   PENNY_DROP_PENDING;
   UNVERIFIED;
   VERIFIED;
 };
type BankAccountInput = 
 record {
   accountHolderName: text;
   accountNumber: text;
   confirmAccountNumber: text;
   ifsc: text;
 };
type BankAccount = 
 record {
   accountHolderName: text;
   accountNumberLast4: text;
   bankName: text;
   branch: text;
   createdAt: Timestamp;
   id: nat;
   ifsc: text;
   providerToken: text;
   userId: nat;
   verificationStatus: BankVerificationStatus;
 };
type AttributeFieldType = 
 variant {
   DATE;
   NUMBER;
   SELECT;
   TEXT;
 };
type AttributeField = 
 record {
   fieldLabel: text;
   fieldType: AttributeFieldType;
   key: text;
   options: vec text;
   required: bool;
   unit: opt text;
 };
type AppConfig = 
 record {
   commissionBps: nat;
   environment: Environment;
   kycAttemptWindowHours: nat;
   kycAutoApproveThreshold: float64;
   kycCheckoutThresholdInr: nat;
   kycMaxAttempts: nat;
   kycPriorityHighBelow: float64;
   kycPriorityMediumBelow: float64;
   otpExpirySecs: nat;
   otpRateLimitMax: nat;
   otpRateLimitWindowSecs: nat;
   payoutHoldHours: nat;
   sessionTtlHours: nat;
 };
type ApiError = 
 variant {
   Conflict: text;
   Forbidden: text;
   InvalidInput: text;
   InvalidTransition: record {
                        fromStatus: text;
                        message: text;
                        toStatus: text;
                      };
   KycInProgress: KycGateInfo;
   KycRequired: KycGateInfo;
   NotFound: text;
   ProviderUnavailable: text;
   RateLimited: record {
                  message: text;
                  retryAfterSecs: nat;
                };
   Unauthorized: text;
 };
type AdminLoginResult = 
 record {
   adminId: nat;
   email: text;
   name: text;
   token: text;
 };
service : {
  addBankAccount: (token: text, input: BankAccountInput) -> (Result_25);
  adminGetConfig: (token: text) -> (Result_19) query;
  adminGetDisputedOrders: (token: text) -> (Result_8) query;
  adminGetKycQueue: (token: text) -> (Result_24) query;
  adminGetListingQueue: (token: text) -> (Result_23) query;
  adminGetReports: (token: text, range: ReportRange) -> (Result_22) query;
  adminLogin: (email: text, password: text) -> (Result_21);
  adminModerateListing: (token: text, listingId: nat, action:
   ModerationAction) -> (Result_1);
  adminResolveDispute: (token: text, orderId: nat, outcome: DisputeOutcome,
   note: text) -> (Result_2);
  adminReviewKyc: (token: text, documentId: nat, decision:
   KycReviewDecision) -> (Result_20);
  adminRunPayoutCycle: (token: text) -> (Result_5);
  adminStartKycReview: (token: text, documentId: nat) -> (Result_20);
  adminUpdateConfig: (token: text, newConfig: AppConfig) -> (Result_19);
  browseListings: (filter: BrowseFilter) -> (vec PublicListing) query;
  completeOnboarding: (token: text, profile: OnboardingProfile) ->
   (Result_18);
  confirmCheckout: (token: text, idempotencyKey: text, succeed: bool) ->
   (Result_17);
  createListing: (token: text, input: ListingInput) -> (Result_1);
  createSupportTicket: (token: text, input: TicketInput) -> (Result_16);
  getCategories: () -> (vec Category) query;
  getKycState: (token: text) -> (Result_3) query;
  getListingDetail: (listingId: nat) -> (Result_15) query;
  getMe: (token: text) -> (Result_14) query;
  getMyBankAccounts: (token: text) -> (Result_13) query;
  getMyListing: (token: text, listingId: nat) -> (Result_1) query;
  getMyListings: (token: text) -> (Result_12) query;
  getMyNotifications: (token: text) -> (Result_11) query;
  getMyOrders: (token: text) -> (Result_8) query;
  getMyPayouts: (token: text) -> (Result_10);
  getMySupportTickets: (token: text) -> (Result_9) query;
  getOrder: (token: text, orderId: nat) -> (Result_2) query;
  getPublicConfig: () -> (PublicConfig) query;
  getSellerOrders: (token: text) -> (Result_8) query;
  initiateCheckout: (token: text, input: CheckoutInput) -> (Result_7);
  logout: (token: text) -> ();
  lookupIfsc: (ifscRaw: text) -> (Result_6) query;
  manageListing: (token: text, listingId: nat, action:
   SellerListingAction) -> (Result_1);
  markAllNotificationsRead: (token: text) -> (Result_5);
  markNotificationRead: (token: text, notificationId: nat) -> (Result_5);
  sendOtp: (phoneRaw: text) -> (Result_4);
  submitKycDocument: (token: text, submission: KycSubmission) -> (Result_3);
  submitListingForPublish: (token: text, listingId: nat) -> (Result_1);
  transitionOrderStatus: (token: text, orderId: nat, newStatus:
   OrderStatus) -> (Result_2);
  updateListing: (token: text, listingId: nat, input: ListingInput) ->
   (Result_1);
  verifyOtp: (phoneRaw: text, otp: text, requestId: text) -> (Result);
}
