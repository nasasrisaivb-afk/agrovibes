# CropVibe — environment variables for LIVE third-party providers.
#
# The current build ships with fully simulated providers (SMS OTP, Razorpay
# payments/penny-drop, Setu/HyperVerge KYC) gated behind the backend's
# Development environment config. Nothing below is required for local
# development. When wiring live providers, read every key from the
# environment — never hardcode or commit secrets.

# ── SMS OTP (MSG91 preferred for India cost/deliverability; Twilio fallback)
MSG91_AUTH_KEY=your-msg91-auth-key            # msg91.com → API → Auth Key
MSG91_OTP_TEMPLATE_ID=your-template-id        # msg91.com → OTP → Templates
TWILIO_ACCOUNT_SID=your-twilio-sid            # console.twilio.com (fallback provider)
TWILIO_AUTH_TOKEN=your-twilio-token           # console.twilio.com

# ── Payments & payouts (Razorpay: UPI-first checkout, Fund Account
#    Validation penny-drop, RazorpayX payouts)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx             # dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_SECRET=your-razorpay-secret      # generated with the key id
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret   # dashboard.razorpay.com → Webhooks

# ── KYC verification (choose one provider)
SETU_CLIENT_ID=your-setu-client-id            # console.setu.co → KYC APIs
SETU_CLIENT_SECRET=your-setu-client-secret    # console.setu.co
HYPERVERGE_APP_ID=your-hyperverge-app-id      # dashboard.hyperverge.co
HYPERVERGE_APP_KEY=your-hyperverge-app-key    # dashboard.hyperverge.co

# ── Object storage for listing images & KYC documents (S3-compatible)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  # Cloudflare R2 (or AWS S3 endpoint)
S3_ACCESS_KEY_ID=your-access-key              # R2 → Manage API Tokens (or AWS IAM)
S3_SECRET_ACCESS_KEY=your-secret-key          # generated with the access key
S3_BUCKET=cropvibe-uploads                    # create in the R2/S3 console
